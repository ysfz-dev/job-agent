# Copy to .env and fill in what you have. .env is gitignored — never share it.
# Every key below is FREE. The agent runs without any of them, just with far
# less coverage of Bahrain, Saudi, Australia and Canada.

# --- Job-alert mailbox (the ONLY real Gulf coverage) -----------------------
# A dedicated Gmail that receives nothing but job alerts. Create alerts on
# LinkedIn, Indeed, Bayt, GulfTalent and Glassdoor using this address, and they
# all deliver here. An app password unlocks the whole mailbox, so that mailbox
# should hold nothing worth unlocking.
#   Gmail -> 2-Step Verification -> App passwords -> Mail
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=yousaf973bh@gmail.com
IMAP_PASS=xxxx xxxx xxxx xxxx
# Gmail label the alerts are filtered into. The reader opens ONLY this folder.
IMAP_FOLDER=JobAlerts

# --- Adzuna: Australia + Canada  (free, instant) ---------------------------
# https://developer.adzuna.com/  -> register -> app_id + app_key, 250 calls/day
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble: Bahrain + Saudi  (free, they email you a key) -----------------
# https://jooble.org/api/about
JOOBLE_KEY=
